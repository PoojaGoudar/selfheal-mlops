# Copy to .env  (cp .env.example .env)  and fill in what you need. Everything is optional.

# LLM incident copilot. Leave empty to use the built-in rule-based fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Price per million tokens, only used for the cost column on the dashboard (set to your model's price)
LLM_PRICE_IN=3.0
LLM_PRICE_OUT=15.0

# Demo speed: seconds of wall-clock time per simulated hour
SIM_SECONDS_PER_HOUR=0.5
# Promote automatically instead of waiting for the human click (for unattended runs only)
AUTO_APPROVE=false
